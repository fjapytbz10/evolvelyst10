---
import "../styles/global.css";

const title = "evolvelyst — Systems Built on Science";
const description =
  "evolvelyst — Systems Built on Science. Atomic Research • Refine • Scale.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F5F5F0" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <div class="ambient-grid" aria-hidden="true"></div>

    <div class="corner corner-top-right" aria-hidden="true"></div>
    <div class="corner corner-bottom-left" aria-hidden="true"></div>

    <main class="hero" aria-labelledby="hero-title">
      <section class="hero-content">
        <div class="brand" aria-label=".evolvelyst">
          <span class="brand-blue">ecocata</span><span class="brand-pink">lyst</span>
        </div>

        <div class="eyebrow" aria-hidden="true">
          <span></span>
          <span>systems laboratory</span>
          <span></span>
        </div>

        <h1 id="hero-title">
          Systems Built on
          <span>Science<span class="accent-dot">.</span></span>
        </h1>

        <p class="tagline">Atomic Research <b>•</b> Refine <b>•</b> Scale</p>

        <div class="divider" aria-hidden="true"></div>
      </section>
    </main>

    <div class="status" aria-label="Pre-launch status">
      <span class="status-dot"></span>
      <span>pre-launch</span>
    </div>
  </body>
</html>
